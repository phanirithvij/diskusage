diff -ruN '--exclude=.git' diskusage-orig/.github/workflows/build-apk.yml diskusage/.github/workflows/build-apk.yml
--- diskusage-orig/.github/workflows/build-apk.yml	1970-01-01 00:00:00.000000000 +0000
+++ diskusage/.github/workflows/build-apk.yml	2026-09-05 10:26:57.530054304 +0000
@@ -0,0 +1,35 @@
+name: Build APK
+
+on:
+  push:
+  workflow_dispatch:
+
+jobs:
+  build:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+
+      - name: Set up JDK 17
+        uses: actions/setup-java@v4
+        with:
+          distribution: 'temurin'
+          java-version: '17'
+
+      - name: Set up Android SDK
+        uses: android-actions/setup-android@v3
+
+      - name: Grant execute permission for gradlew
+        run: chmod +x gradlew
+
+      - name: Install NDK (needed for the native scan.c build)
+        run: sdkmanager "ndk;25.2.9519653"
+
+      - name: Build debug APK
+        run: ./gradlew assembleDebug --stacktrace
+
+      - name: Upload APK
+        uses: actions/upload-artifact@v4
+        with:
+          name: diskusage-debug-apk
+          path: app/build/outputs/apk/debug/*.apk
